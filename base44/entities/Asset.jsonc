// purpose: Physical asset with QR and current custodian.
// domain: money
// isolation: companyId
// owner: assets
// status: canonical
{
  "name": "Asset",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "The PowerCare company (tenant) that owns this asset."
    },
    "assetCode": {
      "type": "string",
      "description": "Serial / asset number stamped on the QR label."
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "stationId": {
      "type": "string",
      "description": "Owning unit (station)."
    },
    "originStationId": {
      "type": "string",
      "description": "Station that bought the asset. Survives inter-station transfer; book cost stays on the buyer."
    },
    "site": {
      "type": "string",
      "description": "Physical location inside the unit."
    },
    "holderId": {
      "type": "string",
      "description": "Current custodian employee id. Never empty \u2014 available assets are held by the unit custodian."
    },
    "holderName": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "in_custody",
        "inspection",
        "maintenance",
        "lost",
        "retired"
      ],
      "default": "available"
    },
    "purchaseDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "usefulLifeMonths": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "warrantyEndDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "inspectionIntervalDays": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "nextInspectionDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "qrCode": {
      "type": "string",
      "description": "Opaque code encoded in the printed QR label."
    },
    "imageUrls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "documents": {
      "type": "array",
      "description": "Invoice, warranty, calibration certificate.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "lostCase": {
      "type": [
        "object",
        "null"
      ],
      "description": "Open investigation for a lost asset; closed only by a documented decision. Keeps both reasons: reason (why the case was opened) and decisionReason (why it was closed).",
      "additionalProperties": true
    },
    "lostHistory": {
      "type": "array",
      "description": "Earlier closed loss cases on this asset, newest first. A new report never overwrites a decided one.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "assetCode",
    "name",
    "stationId",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}