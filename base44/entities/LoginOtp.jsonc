// purpose: LoginOtp tenant row.
// domain: company
// isolation: companyId
// owner: companyDirectory
// status: canonical
{
  "name": "LoginOtp",
  "type": "object",
  "properties": {
    "pendingId": {
      "type": "string",
      "description": "Opaque one-time id returned to the client after a successful password check."
    },
    "kind": {
      "type": "string",
      "description": "'owner' or 'employee'."
    },
    "companyId": {
      "type": "string"
    },
    "employeeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": "string",
      "description": "Address the code was emailed to."
    },
    "codeHash": {
      "type": "string",
      "description": "SHA-256 hash of pendingId::code \u2014 the code itself is never stored."
    },
    "expiresAt": {
      "type": "string"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "pendingId",
    "kind",
    "companyId",
    "email",
    "codeHash",
    "expiresAt"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}