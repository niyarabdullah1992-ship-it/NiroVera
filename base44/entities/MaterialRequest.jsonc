// purpose: MaterialRequest tenant row.
// domain: money
// isolation: companyId
// owner: inventory
// status: canonical
{
  "name": "MaterialRequest",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Tenant of this material request."
    },
    "requesterId": {
      "type": "string",
      "description": "Employee.employeeId of the requester."
    },
    "stationId": {
      "type": "string",
      "description": "Requesting workplace → Station.stationId."
    },
    "sourceStationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Station requested to supply the item."
    },
    "itemId": {
      "type": "string",
      "description": "→ InventoryItem id."
    },
    "quantity": {
      "type": "number",
      "minimum": 1
    },
    "unitPrice": {
      "type": [
        "number",
        "null"
      ],
      "description": "Latest purchase unit price at the source station when requested."
    },
    "totalCost": {
      "type": [
        "number",
        "null"
      ],
      "description": "Financial value of the requested transfer quantity."
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "issued"
      ]
    },
    "supervisorId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "issuedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "companyId",
    "requesterId",
    "stationId",
    "itemId",
    "quantity",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}