// purpose: ProcurementRequest tenant row.
// domain: money
// isolation: companyId
// owner: inventory
// status: canonical
{
  "name": "ProcurementRequest",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Tenant of this procurement request."
    },
    "requestNumber": {
      "type": "string",
      "description": "Human request number."
    },
    "stationId": {
      "type": "string",
      "description": "Requesting workplace → Station.stationId."
    },
    "requesterId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requesterName": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "justification": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "ordered",
        "received"
      ]
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "requestNumber",
    "stationId",
    "items",
    "justification",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}