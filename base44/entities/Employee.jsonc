// purpose: Person record. Session userId is employeeId (also stored as Employee.employeeId).
// domain: people
// isolation: companyId
// owner: companyDirectory
// status: canonical
{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employeeId": {
      "type": "string",
      "description": "Stable client-side id used across the app."
    },
    "companyId": {
      "type": "string",
      "description": "The PowerCare company this employee belongs to."
    },
    "name": {
      "type": "string",
      "description": "Display name. Not a join key."
    },
    "email": {
      "type": "string",
      "description": "Login email. Deduped in the local cache; credentials live on EmployeeCredential."
    },
    "role": {
      "type": "string",
      "description": "App role (director, station_manager, …). Not the Base44 User.role."
    },
    "stationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Home workplace → Station.stationId."
    },
    "phone": {
      "type": "string",
      "description": "Sensitive. Redacted for non-self / non-HR readers."
    },
    "position": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy title. Prefer profile.position."
    },
    "anonymousId": {
      "type": "string",
      "description": "Public anonymous handle. Never the same as employeeId."
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Display cache. Source of truth is PointsLedger — do not treat this as the score ledger."
    },
    "hrLevelId": {
      "type": [
        "string",
        "null"
      ],
      "description": "→ hrLevels blob."
    },
    "hrStationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "HR coverage workplace → Station.stationId."
    },
    "hrClusterId": {
      "type": [
        "string",
        "null"
      ],
      "description": "→ hrClusters blob."
    },
    "canManageTeam": {
      "type": "boolean",
      "default": false
    },
    "managedStations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Station ids this person manages."
    },
    "profile": {
      "type": "object",
      "properties": {
        "gradeId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference to the company job grade."
        },
        "maxStations": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "description": "Maximum stations; null means unlimited."
        },
        "position": {
          "type": [
            "string",
            "null"
          ],
          "description": "Employee-managed free-form position title."
        }
      },
      "additionalProperties": true
    },
    "certificates": {
      "type": "array",
      "description": "Competency / license files on the person. Sensitive.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "leaveRequests": {
      "type": "array",
      "description": "Leave inbox nested here — not a first-class collection. Cloud snapshot: leaveRoster blob.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "otherRequests": {
      "type": "array",
      "description": "study_consent, leave top-up, overtime assignment, written consent. Signing token lives here or on SignatureRequest — not on WorkProof.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "hrMessages": {
      "type": "array",
      "description": "Private HR notes. Redacted for non-self / non-HR readers.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "employeeId",
    "companyId",
    "name",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}