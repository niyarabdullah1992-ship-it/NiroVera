// purpose: Envelope for every blob category. One row per (companyId, category).
// domain: company
// isolation: companyId
// owner: companyDirectory
// status: canonical
{
  "name": "CompanyDataBlob",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "The PowerCare company (tenant) this data belongs to."
    },
    "category": {
      "type": "string",
      "description": "Blob collection key. Canonical list: base44/data/domains.jsonc (kind: blob). Examples: tasks, workProofs, personalAttendance, payrollRuns."
    },
    "payload": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "The full array snapshot for this category."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}