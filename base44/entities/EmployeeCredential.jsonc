// purpose: Password hash only. Never localStorage.
// domain: people
// isolation: companyId
// owner: companyDirectory
// status: canonical
{
  "name": "EmployeeCredential",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "The PowerCare company (tenant) this credential belongs to."
    },
    "employeeId": {
      "type": "string",
      "description": "Stable client-side employee id (matches Employee.employeeId)."
    },
    "email": {
      "type": "string",
      "description": "Lowercased login email."
    },
    "passwordHash": {
      "type": "string",
      "description": "Server-only PBKDF2 password hash. Legacy hashes are upgraded after successful login."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "employeeId",
    "email",
    "passwordHash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}