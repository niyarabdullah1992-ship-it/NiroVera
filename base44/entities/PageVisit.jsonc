// purpose: Anonymous marketing analytics. No companyId by design.
// domain: platform
// isolation: none (platform / preview / dead)
// owner: pageVisits
// status: platform
{
  "name": "PageVisit",
  "type": "object",
  "properties": {
    "visitorId": {
      "type": "string",
      "description": "Anonymous random id stored in the visitor's browser (no PII)."
    },
    "path": {
      "type": "string",
      "description": "The page path visited, e.g. '/'."
    },
    "referrer": {
      "type": "string",
      "description": "document.referrer host, if any."
    },
    "device": {
      "type": "string",
      "description": "'mobile' or 'desktop'."
    },
    "day": {
      "type": "string",
      "description": "Visit date as YYYY-MM-DD (Asia/Riyadh) for fast daily aggregation."
    },
    "country": {
      "type": "string",
      "description": "Visitor country resolved from IP (e.g. 'Saudi Arabia')."
    },
    "city": {
      "type": "string",
      "description": "Visitor city resolved from IP."
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Elapsed visit duration reported by the browser."
    },
    "lastSeenAt": {
      "type": [
        "string",
        "null"
      ],
      "description": "Latest visit heartbeat timestamp."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "visitorId",
    "day"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}