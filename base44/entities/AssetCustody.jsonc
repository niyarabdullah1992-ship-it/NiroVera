// purpose: AssetCustody tenant row.
// domain: money
// isolation: companyId
// owner: assets
// status: canonical
{
  "name": "AssetCustody",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Tenant of this handover."
    },
    "assetId": {
      "type": "string",
      "description": "→ Asset id."
    },
    "fromId": {
      "type": [
        "string",
        "null"
      ]
    },
    "fromName": {
      "type": "string"
    },
    "toId": {
      "type": "string"
    },
    "toName": {
      "type": "string"
    },
    "stationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "handedAt": {
      "type": "string",
      "description": "ISO timestamp of the handover."
    },
    "condition": {
      "type": "string",
      "description": "Asset condition recorded at handover."
    },
    "imageUrls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "fromSignatureUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "toSignatureUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "auditRef": {
      "type": [
        "string",
        "null"
      ],
      "description": "Audit log reference for this transfer."
    },
    "notes": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "assetId",
    "toId",
    "toName",
    "handedAt"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}