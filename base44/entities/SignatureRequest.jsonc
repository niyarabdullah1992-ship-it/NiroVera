// purpose: Secure Sign request. Proof Cycle step 5.
// domain: trust
// isolation: companyId
// owner: multiSign
// status: canonical
{
  "name": "SignatureRequest",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "The PowerCare company this request belongs to."
    },
    "creatorId": {
      "type": "string"
    },
    "creatorName": {
      "type": "string"
    },
    "creatorEmail": {
      "type": "string"
    },
    "stationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "fileName": {
      "type": "string"
    },
    "docUrl": {
      "type": "string",
      "description": "URL of the latest immutable signed version."
    },
    "appUrl": {
      "type": "string"
    },
    "verificationId": {
      "type": "string"
    },
    "finalHash": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 of the fully-signed final file. Set only after the creator releases."
    },
    "releasedAt": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the creator released the file. Download and the completion notice wait for this."
    },
    "releasedByName": {
      "type": [
        "string",
        "null"
      ],
      "description": "Display name of the creator who released the file."
    },
    "status": {
      "type": "string",
      "description": "pending while anyone is still unanswered or the creator has not released the file. A refusal never stops the remaining parties. Silence does not block the file: the creator can continue without the rest (skipped). The final copy cannot be downloaded until the creator releases. A 1–3 day retract window that closes without the remaining parties signing is a deadline refusal (رفض بانتهاء المدة), not a skip. Option 0 never auto-refuses. completed = all signed and the creator released. completed_with_refusal = released with at least one signature and at least one refusal or skip. rejected = released with nobody signed. deleted = soft-deleted by the creator with a required reason.",
      "enum": [
        "pending",
        "completed",
        "completed_with_refusal",
        "rejected",
        "deleted"
      ]
    },
    "signingMode": {
      "type": "string",
      "enum": [
        "sequential",
        "parallel"
      ],
      "default": "parallel",
      "description": "Always treated as parallel. Every pending party may sign in any order. sequential on old records is ignored."
    },
    "currentSignerIndex": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Count of parties who have already signed. Not a turn index — it never blocks another pending signer."
    },
    "expiresAt": {
      "type": "string"
    },
    "lastActivityAt": {
      "type": "string"
    },
    "rejectionReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the creator soft-deleted the request. The record stays for the audit trail."
    },
    "deletionReason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Required written reason for the delete audit event."
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Independent signing parties, HR identity snapshots, fields, and statuses."
    },
    "auditTrail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Immutable chronological signing events with actor, time, document hash, and location."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "creatorId",
    "fileName",
    "docUrl",
    "status",
    "signers"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}