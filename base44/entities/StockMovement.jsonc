// purpose: StockMovement tenant row.
// domain: money
// isolation: companyId
// owner: inventory
// status: canonical
{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Tenant of this movement."
    },
    "movementNumber": {
      "type": "string",
      "description": "Human-readable company movement number, for example MOV-2026-000001."
    },
    "itemId": {
      "type": "string",
      "description": "→ InventoryItem id."
    },
    "movementType": {
      "type": "string",
      "enum": [
        "receive",
        "purchase",
        "issue",
        "return",
        "transfer",
        "reversal"
      ]
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "fromLocationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "toLocationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "employeeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "performedBy": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "workReference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Task or project for which stock was issued."
    },
    "workDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date the material was issued to station work."
    },
    "balanceBefore": {
      "type": [
        "number",
        "null"
      ]
    },
    "balanceAfter": {
      "type": [
        "number",
        "null"
      ]
    },
    "sourceBalanceBefore": {
      "type": [
        "number",
        "null"
      ]
    },
    "sourceBalanceAfter": {
      "type": [
        "number",
        "null"
      ]
    },
    "destinationBalanceBefore": {
      "type": [
        "number",
        "null"
      ]
    },
    "destinationBalanceAfter": {
      "type": [
        "number",
        "null"
      ]
    },
    "purchasePrice": {
      "type": [
        "number",
        "null"
      ],
      "description": "Optional unit price recorded for a direct station purchase."
    },
    "unitPrice": {
      "type": [
        "number",
        "null"
      ]
    },
    "totalCost": {
      "type": [
        "number",
        "null"
      ]
    },
    "supplierName": {
      "type": [
        "string",
        "null"
      ]
    },
    "purchaseDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "Purchase timestamp in ISO format."
    },
    "invoiceUrl": {
      "type": [
        "string",
        "null"
      ],
      "description": "Uploaded purchase invoice file URL."
    },
    "invoiceName": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original purchase invoice file name."
    },
    "imageUrls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "traceAllocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Tracked quantity allocations linking each movement to its origin, parent movement, and station route."
    },
    "reversedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reversedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "reversalReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reversalMovementId": {
      "type": [
        "string",
        "null"
      ]
    },
    "isReversal": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "companyId",
    "itemId",
    "movementType",
    "quantity",
    "performedBy"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}