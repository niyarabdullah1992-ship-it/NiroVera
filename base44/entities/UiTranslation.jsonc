// purpose: Platform row (UiTranslation). No tenant isolation.
// domain: platform
// isolation: none (platform / preview / dead)
// owner: uiTranslations
// status: platform
{
  "name": "UiTranslation",
  "type": "object",
  "properties": {
    "lang": {
      "type": "string",
      "description": "Language code, e.g. 'ja', 'ko', 'de'."
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Map of UI string key -> translated value for this language."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "lang"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}