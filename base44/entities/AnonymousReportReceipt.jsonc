// purpose: AnonymousReportReceipt tenant row.
// domain: voice
// isolation: companyId
// owner: complaints
// status: canonical
{
  "name": "AnonymousReportReceipt",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Tenant of the anonymous report. Missing = receipt cannot be scoped."
    },
    "reportId": {
      "type": "string",
      "description": "→ anonymousReports[].id. Never store the sender name on the report itself."
    },
    "employeeId": {
      "type": "string",
      "description": "Private server-side link used only to let the sender follow their own anonymous report."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "reportId",
    "employeeId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": false,
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}