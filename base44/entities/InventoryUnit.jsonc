// purpose: Retired do-not-write. One-shot hydrate into InventoryItem.locationBalances on list/getItem. Never create/update units again.
// domain: money
// isolation: companyId
// owner: inventory
// status: unused
{
  "name": "InventoryUnit",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Tenant of this location balance."
    },
    "itemId": {
      "type": "string",
      "description": "→ InventoryItem id. Live quantity is on InventoryItem.locationBalances only."
    },
    "locationId": {
      "type": "string",
      "description": "Workplace / warehouse station id."
    },
    "quantity": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "itemId",
    "locationId",
    "quantity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
