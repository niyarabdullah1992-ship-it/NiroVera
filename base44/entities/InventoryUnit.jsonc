// purpose: Cloud per-location quantity. Frontend inventoryApi.js force-locals to InventoryItem.locationBalances — two quantity truths. Do not treat this as the preview sou
// domain: money
// isolation: companyId
// owner: inventory
// status: canonical
{
  "name": "InventoryUnit",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Tenant of this location balance."
    },
    "itemId": {
      "type": "string",
      "description": "→ InventoryItem id. Live inventory also stores locationBalances on the item."
    },
    "locationId": {
      "type": "string",
      "description": "Workplace / warehouse station id."
    },
    "quantity": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "itemId",
    "locationId",
    "quantity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}